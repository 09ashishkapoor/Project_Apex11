<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is a dark room: every surface, including the launch window,
         matches Direction 02's ground colour so there is no white flash. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0D0506</item>
        <item name="colorPrimaryDark">#0D0506</item>
        <item name="colorAccent">#EDAE55</item>
        <item name="android:windowBackground">#0D0506</item>
        <item name="android:statusBarColor">#0D0506</item>
        <item name="android:navigationBarColor">#0D0506</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#0D0506</item>
        <item name="android:navigationBarColor">#0D0506</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#0D0506</item>
        <item name="windowSplashScreenBackground">#0D0506</item>
    </style>
</resources>
